# 이 파일을 .env로 복사한 뒤 실제 값을 채우세요. (.env는 git에 절대 커밋하지 마세요)
# 대부분의 PaaS(Fly.io, Railway, Render 등)는 대시보드에서 환경변수를 직접 입력하게 되어
# 있어서 .env 파일 자체를 안 씁니다 — 그 경우 이 목록을 참고해서 대시보드에 똑같이 넣어주세요.

# 필수 - JWT 서명 키. 운영 환경(NODE_ENV=production)에서 이 값이 없으면 서버가 아예 기동을
# 거부합니다(개발용 기본값으로 조용히 넘어가지 않도록 일부러 막아뒀습니다).
# 생성 예시: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# 운영 배포 시 반드시 production으로 설정
NODE_ENV=development

# 서버 포트 - 대부분의 PaaS는 자체적으로 이 값을 주입하므로 보통 직접 정할 필요 없음
PORT=4000

# PWA/웹 프론트가 이 API를 다른 도메인에서 호출할 경우 그 오리진을 콤마로 구분해 나열
# 예: https://safety-meerkat.netlify.app,https://safetymeerkat.co.kr
# 개발(NODE_ENV=development)에서 비워두면 편의를 위해 전체 허용(*)됩니다.
# 운영(NODE_ENV=production)에서는 JWT_SECRET과 동일하게, 이 값이 없으면 서버가 아예
# 기동을 거부합니다(전체 허용 상태로 조용히 운영되는 것을 막기 위해 일부러 막아뒀습니다).
CORS_ORIGIN=

# SQLite 파일 저장 위치 - 컨테이너 배포 시 반드시 영구 볼륨 경로를 가리키게 해야 재배포 시
# 데이터가 사라지지 않음 (README 배포 섹션 참고)
DB_PATH=./data.sqlite

# 2026-08-30: 백업 파일 다운로드용 비밀키(GET /admin/backup?key=...). 이 값을 아는 사람만
# 백업을 받을 수 있습니다. 백업 파일에는 이 서버를 쓰는 "모든" 회사의 데이터가 통째로
# 들어있으므로, 특정 회사의 관리자 계정 권한과는 완전히 분리된 별도 통로입니다 - 절대
# 일반 로그인 비밀번호와 같은 값을 쓰지 마세요. 설정 안 하면 백업 다운로드 자체가
# 비활성화됩니다(설정하지 않았다고 전체 허용되는 방향이 아니라 안전한 쪽으로 막힙니다).
# 생성 예시: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKUP_SECRET=

# ============================================================================
# 2026-09-10: 최초 관리자 계정 자동 생성 (선택)
# ----------------------------------------------------------------------------
# 서버를 새로 배포하면 계정이 하나도 없어서 로그인할 방법이 없습니다. 아래 두 값을
# 설정해두면 서버가 처음 기동할 때 "회사 + 사업장 + 관리자 계정"을 한 번에 만들어
# 바로 로그인할 수 있습니다. (설정하지 않으면 아무 일도 하지 않으며, 대신
# 브라우저에서 서버주소 + /setup 페이지로 직접 만들 수 있습니다)
#
# ⚠️ 이 계정은 회사 전체 관리자(company_admin)이고, 이 시스템은 건강진단·스트레스
#    상담 등 개인정보보호법상 "민감정보"를 다룹니다. 실제 근로자 데이터를 넣기 전에
#    반드시 추측하기 어려운 비밀번호로 바꾸세요.
#
# ⚠️ 이미 사용자가 한 명이라도 있는 서버에서는 이 설정이 무시됩니다.
#    (기존 데이터를 덮어쓰는 사고를 막기 위한 안전장치입니다)
BOOTSTRAP_ADMIN_ID=
BOOTSTRAP_ADMIN_PASSWORD=

# 아래는 선택 - 비워두면 각각 "기본 회사", "본사", "관리자"로 만들어집니다.
BOOTSTRAP_ORG_NAME=
BOOTSTRAP_SITE_NAME=
BOOTSTRAP_ADMIN_NAME=
